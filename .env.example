# ApplyPilot Environment Configuration
# Copy to ~/.applypilot/.env and fill in your values.

# LLM Provider (pick one or more)
GEMINI_API_KEY=                 # Gemini (recommended default)
# OPENAI_API_KEY=               # OpenAI
# ANTHROPIC_API_KEY=            # Anthropic
# LLM_URL=http://127.0.0.1:8080/v1  # Local OpenAI-compatible endpoint

# Model routing
# Use a fully-qualified model string when setting LLM_MODEL.
# Examples:
# LLM_MODEL=gemini/gemini-3.0-flash
# LLM_MODEL=openai/gpt-4o-mini
# LLM_MODEL=anthropic/claude-haiku-4-5
# LLM_MODEL=openai/local-model
# Optional per-tier overrides:
# LLM_MODEL_GENERAL=gemini/gemini-3.0-flash
# LLM_MODEL_TAILOR=gemini/gemini-2.5-pro
# Generic key for providers not covered above:
# LLM_API_KEY=

# Auto-Apply (optional)
CAPSOLVER_API_KEY=        # For CAPTCHA solving during auto-apply

# Proxy (optional, for scraping)
# PROXY=host:port:user:pass
