# ApplyPilot Environment Configuration
# Copy to ~/.applypilot/.env and fill in your values.

# ── LLM Provider ─────────────────────────────────────────────────────────
# Choose: claude (default), gemini, openai, codex
# LLM_PROVIDER=claude

# Model override — uses provider default if not set
# Claude defaults:  general=sonnet, tailor=claude-opus-4-6
# Gemini defaults:  general=gemini-2.5-flash-lite, tailor=gemini-2.5-pro
# OpenAI defaults:  general=gpt-4o-mini, tailor=gpt-4o
# LLM_MODEL=sonnet

# Required if LLM_PROVIDER=gemini and Gemini CLI is unavailable
# GEMINI_API_KEY=

# Required if LLM_PROVIDER=openai
# Optional fallback if LLM_PROVIDER=codex and Codex CLI is unavailable
# OPENAI_API_KEY=

# ── Auto-Apply (optional) ─────────────────────────────────────────────────
CAPSOLVER_API_KEY=        # For CAPTCHA solving during auto-apply

# ── Proxy (optional, for scraping) ───────────────────────────────────────
# PROXY=host:port:user:pass
